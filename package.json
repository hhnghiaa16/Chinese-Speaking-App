{
  "name": "hanapp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "mobile": "npm run start -w @hanapp/mobile",
    "mobile:android": "npm run android -w @hanapp/mobile",
    "mobile:ios": "npm run ios -w @hanapp/mobile",
    "mobile:web": "npm run web -w @hanapp/mobile",
    "api": "npm run start:dev -w @hanapp/api",
    "api:build": "npm run build -w @hanapp/api",
    "api:start": "npm run start -w @hanapp/api"
  }
}
